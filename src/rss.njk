---
permalink: /rss.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0">
    <channel>
        <title>{{ site.feedTitle | xml }}</title>
        <link>{{ site.url | xml }}</link>
        <description>{{ site.feedDescription | xml }}</description>
        <lastBuildDate>{{ site.buildDate | rfc822Date }}</lastBuildDate>
        <docs>https://validator.w3.org/feed/docs/rss2.html</docs>
        <language>en</language>
        <copyright>© {{ site.buildDate.getUTCFullYear() }} mahata.or</copyright>
{%- for post in collections.posts %}
        <item>
            <title>{{ post.data.title | cdata | safe }}</title>
            <link>{{ site.url | xml }}/posts/{{ post.data.slug | xml }}</link>
            <guid isPermaLink="false">{{ site.url | xml }}/posts/{{ post.data.slug | xml }}</guid>
            <pubDate>{{ post.date | rfc822Date }}</pubDate>
            <description>{{ post.rawInput | trim | cdata | safe }}</description>
        </item>
{%- endfor %}
    </channel>
</rss>
